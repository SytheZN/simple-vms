<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <ApplicationId Condition="'$(Configuration)' == 'Debug'">com.sythezn.simplevms.debug</ApplicationId>
    <ApplicationId Condition="'$(Configuration)' != 'Debug'">com.sythezn.simplevms</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(Version)' != ''">$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(AndroidVersionCode)' != ''">$(AndroidVersionCode)</ApplicationVersion>
    <ApplicationVersion Condition="'$(AndroidVersionCode)' == ''">1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(SIMPLEVMS_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(SIMPLEVMS_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningStorePass>$(SIMPLEVMS_KEYSTORE_PASS)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>$(SIMPLEVMS_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass Condition="'$(SIMPLEVMS_KEY_PASS)' != ''">$(SIMPLEVMS_KEY_PASS)</AndroidSigningKeyPass>
    <AndroidSigningKeyPass Condition="'$(SIMPLEVMS_KEY_PASS)' == ''">$(SIMPLEVMS_KEYSTORE_PASS)</AndroidSigningKeyPass>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Client.Core/Client.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <LogoDrawable Include="../Client.Theme/logo/512.png" DrawableName="icon" />
    <LogoDrawable Include="../Client.Theme/logo/256.png" DrawableName="banner" />
    <LogoDrawable Include="../Client.Theme/logo/notification.png" DrawableName="ic_notification" />
    <AndroidResource Include="@(LogoDrawable->'$(BaseIntermediateOutputPath)logo-drawables/%(DrawableName).png')"
                     Link="Resources/drawable/%(DrawableName).png" />
  </ItemGroup>
  <Target Name="CopyLogoDrawables"
          BeforeTargets="AndroidPrepareForBuild;_ComputeAndroidResourcePaths"
          Inputs="@(LogoDrawable)"
          Outputs="@(LogoDrawable->'$(BaseIntermediateOutputPath)logo-drawables/%(DrawableName).png')">
    <Copy SourceFiles="@(LogoDrawable)"
          DestinationFiles="@(LogoDrawable->'$(BaseIntermediateOutputPath)logo-drawables/%(DrawableName).png')" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" />
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Security.SecurityCrypto" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>
</Project>
